{
  "info": {
    "name": "Enterprise IT Incident Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Employee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Soma Manoj\",\n  \"email\": \"soma@company.com\",\n  \"password\": \"Password123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"employee@company.com\",\n  \"password\": \"ChangeMeEmployee123!\"\n}"
        }
      }
    },
    {
      "name": "Create Incident",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/incidents",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Outlook cannot send mail\",\n  \"description\": \"Send button stays disabled after latest update\",\n  \"category\": \"EMAIL\",\n  \"priority\": \"HIGH\"\n}"
        }
      }
    },
    {
      "name": "List Incidents",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/incidents?priority=HIGH&status=OPEN"
      }
    },
    {
      "name": "Assign Incident",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/incidents/1/assign",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"engineerId\": 2\n}"
        }
      }
    },
    {
      "name": "Update Status",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/incidents/1/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"comment\": \"Investigating mail connector\"\n}"
        }
      }
    },
    {
      "name": "Add Comment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/incidents/1/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"Reset mailbox quota and asked user to retry.\"\n}"
        }
      }
    },
    {
      "name": "Incident History",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/incidents/1/history"
      }
    },
    {
      "name": "Dashboard Stats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/dashboard/stats"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ]
}
