# Copy this file to .env and replace the values before running against MySQL.
# Never commit real passwords.

DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000
ADMIN_PASSWORD=ChangeMeAdmin123!
ENGINEER_PASSWORD=ChangeMeEngineer123!
SPRING_PROFILES_ACTIVE=mysql
